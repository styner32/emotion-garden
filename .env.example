APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
EXTRA_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
AUTH_MODE=single_user
DATABASE_URL=postgres://app:change_me@127.0.0.1:5432/emotion_garden?sslmode=disable
IDEMPOTENCY_SECRET=dev-emotion-garden-hmac-secret-change-in-prod

# Leave empty to use built-in streaming Mock AI providers (mock_openai / mock_gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=
ALLOW_MOCK_AI=true

AI_MODEL_CONFIG=./config/models.yaml
AVATAR_CATALOG_CONFIG=./config/avatars.yaml
FLOWER_CATALOG_CONFIG=./config/flowers.yaml
RITUAL_CONFIG=./config/rituals.yaml
PROMPTS_DIR=./prompts
STATIC_DIR=./web/dist

AI_WORKER_CONCURRENCY=4
AI_RUN_TIMEOUT_SECONDS=60
AI_FIRST_TEXT_TIMEOUT_SECONDS=25
AI_IDLE_TIMEOUT_SECONDS=20

GARDEN_DEFAULT_COLS=4
GARDEN_DEFAULT_ROWS=3
GARDEN_MAX_COLS=6
GARDEN_MAX_ROWS=8

DEFAULT_TIMEZONE=Asia/Seoul
CONTENT_CONTEXT_MAX_BYTES=131072
CONVERSATION_MAX_TURNS=100
IDEMPOTENCY_RETENTION_DAYS=7
USAGE_RETENTION_DAYS=90
